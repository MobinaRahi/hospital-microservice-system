# ============================================================
# Hospital Microservice System — نمونهٔ متغیرهای محیطی
#
# این فایل الگوست و در گیت نگهداری می‌شود.
# برای اجرای واقعی:
#     cp .env.example .env
# سپس مقادیر .env را با مقادیر واقعی خودتان جایگزین کنید.
# فایل .env هرگز نباید در گیت قرار بگیرد.
# ============================================================

# ---------- Oracle Database (کاربر مدیر) ----------
ORACLE_PASSWORD=oracle123
APP_USER=appuser
APP_USER_PASSWORD=appuser123

# ---------- AuthService (پورت میزبان 8281) ----------
AUTH_DB_USERNAME=auth
AUTH_DB_PASSWORD=auth123

# ---------- CoreService (پورت میزبان 8382) ----------
CORE_DB_USERNAME=core
CORE_DB_PASSWORD=core123

# ---------- ClinicalService (پورت میزبان 8383) ----------
CLINICAL_DB_USERNAME=clinical
CLINICAL_DB_PASSWORD=clinical123

# ---------- InventoryService (پورت میزبان 8084) ----------
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=inventory123

# ---------- BillingService (پورت میزبان 8085) ----------
BILLING_DB_USERNAME=billing
BILLING_DB_PASSWORD=billing123

# ---------- AdminService (پورت میزبان 8086) ----------
ADMIN_DB_USERNAME=admin
ADMIN_DB_PASSWORD=admin123

# ---------- JWT ----------
# ⚠️ هشدار: قبل از استقرار در محیط واقعی حتماً این مقدار را عوض کنید.
# برای ساخت یک کلید امن تصادفی:
#     openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=mySuperSecretKeyForJWTTokenGenerationWithHighSecurity1234567890!@#$%^&*()_+

# مدت اعتبار توکن‌ها (بر حسب میلی‌ثانیه)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ---------- JPA ----------
# مقادیر مجاز: update | validate | none
# در محیط واقعی «validate» یا «none» توصیه می‌شود.
JPA_DDL_AUTO=update