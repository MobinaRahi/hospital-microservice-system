target/
build/
dist/
!.mvn/wrapper/maven-wrapper.jar

# ---------- Logs ----------
logs/
*.log
*.log.*

# ---------- Node / Frontend ----------
node_modules/
.vite/
frontend/dist/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Misc ----------
*.tmp
*.bak
*~
